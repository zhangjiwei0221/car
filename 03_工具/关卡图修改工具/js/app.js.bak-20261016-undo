      }
      // 进度区域专用对比图（需求 §六.4）：用条目里存的区域数据离屏重绘专用画布，
      // 不是主画布截屏；条目没做过区域对比时如实放缺失说明，不拿别的图充数。
      var rcCv = buildRegionCompareCanvasFromEntry(e);
      if (rcCv) {
