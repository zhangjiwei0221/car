        '- 方案文件：' + ((e.genParamsUsed && e.genParamsUsed.fileName) || '未导入方案（使用工具默认参数）'),
        '- 修改时间：' + (e.editedAt || '—'),
        '- 重构时间：' + (e.reconstructedAt || '—'),
