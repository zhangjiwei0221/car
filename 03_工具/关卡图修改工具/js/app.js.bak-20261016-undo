    L.push('- 用到的颜色：' + st.colorUnion.join(' '));
    L.push('');
    L.push('## 目录');
    L.push('');
    L.push('```');
    L.push('图纸/    <名>.txt   只含主体的像素图纸（首行「像素矩阵」+ 空格分隔色号）');
    L.push('清单.csv            逐张一行，含画布尺寸、非空像素、外接矩形、来源与提取操作');
    L.push('说明.md             本文件');
    L.push('```');
