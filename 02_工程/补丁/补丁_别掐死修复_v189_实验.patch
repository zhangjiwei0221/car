+    var MAXR = (config.strangleRepairMax != null) ? Math.max(1, parseInt(config.strangleRepairMax, 10)) : 3;
+    for (var di = 0; di < b0.details.length && removed < MAXR; di++) {
+      var c = b0.details[di].color;
