+          if (x.numice > 0) { marks.push({ kind: 'numice', at: [r, cc], color: d, of: c, was: x.numice }); x.numice = 0; removed++; did = true; }
+        }
+        if (did) continue;
+        // 再拆链（整组一起拆，否则留下半组）
+        for (var r2 = 0; r2 < board.rows && !did; r2++) for (var c2 = 0; c2 < board.cols && !did; c2++) {
