+    const row = { image: id, case: tc.name, debtEvery: tc.debtEvery || null, targetBuffer: tc.targetBuffer || null, maxDebt: tc.maxDebt || 8, ms: Date.now() - t, level: !!(r && r.level), valid: !!(r && r.valid), structural: r && r.structural,
