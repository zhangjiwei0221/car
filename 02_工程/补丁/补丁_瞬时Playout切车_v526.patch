+/** v526 · 瞬时连锁生成计划：按真实最左空槽 / 最近曼哈顿 / 容量封顶生成每车像素归属。 */
+var AntSolver = AntSolver || {};
+AntSolver.InstantPlayout = (function () {
+  function parsed(level) { return level && level.rows && level.board ? level : AntSolver.parseLevel(level); }
