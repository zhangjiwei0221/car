+#!/usr/bin/env node
+'use strict';
+const fs=require('fs'),path=require('path'),vm=require('vm');const ROOT=path.join(__dirname,'..','..'),BIN=path.join(ROOT,'02_工程','完整主bin快照_20261012','bin','js');
+const files=['utils.js','color-libs.js','simulator.js','solver-strategy.js','solver.js','playersim.js','analysis.js','car-sequencer.js','solver-analysis.js','experience-goal.js'];const sb={console:{log(){},warn(){},error(){}},WeakMap,Map,Set,Date,Math,JSON};vm.createContext(sb);for(const f of files)vm.runInContext(fs.readFileSync(path.join(BIN,f),'utf8'),sb,{filename:f});const A=sb.AntSolver;
+const args=process.argv.slice(2),inputs=args.filter((x,i)=>!x.startsWith('--')&&(i===0||args[i-1]!=='--out')),oi=args.indexOf('--out'),outFile=oi>=0?args[oi+1]:'';function opt(n,d){const i=args.indexOf('--'+n);return i>=0?+args[i+1]:d;}if(!inputs.length)throw new Error('需要关卡JSON');
+const rows=[];for(const file of inputs){const raw=JSON.parse(fs.readFileSync(file,'utf8')),lv=A.parseLevel(raw.spools?A.fromGameFormat(raw):raw),r=A.ExperienceGoal.evaluateRoutes(lv,{multiTimeMs:opt('multi-time',4000),multiNodes:opt('nodes',6000),maxRoutes:opt('routes',6)});rows.push({file,report:r});console.log(JSON.stringify({file,pass:r.pass,routeCount:r.routeCount,multi:r.multi,best:r.bestVerified&&{source:r.bestVerified.source,quick:r.bestVerified.quick.metrics,full:r.bestVerified.full&&r.bestVerified.full.metrics,release:r.bestVerified.full&&r.bestVerified.full.releaseDecision&&r.bestVerified.full.releaseDecision.status},ms:r.elapsedMs}));}
+if(outFile)fs.writeFileSync(outFile,JSON.stringify({schema:'experience-route-batch-v1',rows},null,2)+'\n');
