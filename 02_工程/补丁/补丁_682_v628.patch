+          questionPixels += cell.count;
+        }
+      }
+      if (cell.t === 'pipe') pipe++;
+    }
+  }
+
+  const solvePicks = uniquePicks(solve);
+  const routeKeys = new Set([poseKey(solvePicks.slice(0, 12))]);
