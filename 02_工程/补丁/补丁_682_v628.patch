+        sum += cell.count;
+        minCapacity = Math.min(minCapacity, cell.count);
+        maxCapacity = Math.max(maxCapacity, cell.count);
+        if (cell.numice > 0) ice++;
+        if (cell.chain > 0) chain++;
+        if (cell.q) {
