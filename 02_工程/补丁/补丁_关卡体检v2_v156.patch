+                               difficulty: (en.difficulty && en.difficulty.score != null) ? en.difficulty.score : null });
+          } else skipped++;
+        } catch (e) { skipped++; }
+        idx++; next();
+      }, 0);
+    }
+    next();
+  }
+
+  function renderChokeAudit(rows, skipped, ms) {
+    var body = document.getElementById('choke-audit-body');
+    if (!body) return;
+    lastChokeAudit = rows;
+    if (!rows.length) {
