+    }
+    var html = '';
+    if (!q.length) html = '<div class="edit-pq-empty">队列空的：点下面「＋ 加一辆」。空队列的管道只当障碍用。</div>';
+    for (var i = 0; i < q.length; i++) {
+      var b = q[i];
