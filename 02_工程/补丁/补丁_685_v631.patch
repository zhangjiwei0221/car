+ * PlayerSim seeds are used. The output narrows the manual ice-gate search.
+ */
+
+const fs = require('fs');
+const path = require('path');
+const B = require('./Build006Thickness_v688');
+
+const ROOT = path.resolve(__dirname, '..', '..');
