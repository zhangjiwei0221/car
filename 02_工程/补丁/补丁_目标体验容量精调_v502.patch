+      midBuffer5Pct: midN ? +(mid5 / midN * 100).toFixed(1) : null,
+      maxBuffer5Run: max5Run };
+  }
+
+  /** 从同一条参考解的高压父状态分叉；找到“有限步内释压且最终通关”才记 found。 */
